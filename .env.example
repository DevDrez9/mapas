# Plantilla de variables. Cópiala como .env en la raíz del back y cambia las claves.
# Si la contraseña tiene caracteres especiales (@ : / # ?), evítalos o codifícalos,
# porque forman parte de la DATABASE_URL.
#
# Generar claves seguras en Linux:  openssl rand -hex 24

POSTGRES_USER=rutas
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=rutas
POSTGRES_HOST_PORT=5433
OSRM_HOST_PORT=5000
OSRM_MOTO_HOST_PORT=5001
OSRM_VERSION=v26.10.0-debian

# Clave para administrar proyectos y API keys (header "x-admin-token").
# Mínimo 24 caracteres. Si está vacía, los endpoints /admin quedan deshabilitados.
ADMIN_TOKEN=cambia_este_token_de_administrador

# Límite de peticiones por API key (por segundo y ráfaga máxima).
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Tiempo máximo de espera a OSRM, en milisegundos.
OSRM_TIMEOUT_MS=10000

# Para desarrollo local fuera de Docker (npm run start:dev, prisma migrate dev, prisma studio).
# Dentro de Docker, docker-compose.yml reemplaza estas tres por las direcciones internas.
DATABASE_URL=postgresql://rutas:cambia_esta_clave@localhost:5433/rutas?schema=public
OSRM_CAR_URL=http://localhost:5000
OSRM_MOTO_URL=http://localhost:5001
