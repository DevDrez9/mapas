# Plantilla de variables. Cópiala como .env en la raíz del back y cambia la contraseña.
# Si la contraseña tiene caracteres especiales (@ : / # ?), evítalos o codifícalos,
# porque forman parte de la DATABASE_URL.

POSTGRES_USER=rutas
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=rutas
POSTGRES_HOST_PORT=5433
OSRM_HOST_PORT=5000

# Perfil de OSRM: car | foot | bicycle
OSRM_PROFILE=car
OSRM_VERSION=v26.10.0-debian

# Para desarrollo local fuera de Docker (npm run start:dev, prisma migrate dev, prisma studio):
DATABASE_URL=postgresql://rutas:cambia_esta_clave@localhost:5433/rutas?schema=public
OSRM_URL=http://localhost:5000
